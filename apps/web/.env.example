# Environment variables example
# Copy this file to .env.local and update the values as needed
# The app is fully client-side (no database, no auth) — only two knobs matter.

# Node
NODE_ENV=development

# Public — baked into the client bundle at BUILD time
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Optional — only the 音效 (Freesound) sound-effects search needs these
FREESOUND_CLIENT_ID=
FREESOUND_API_KEY=
